generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum Program {
  DESQBRO_BEBES
  DESQBRO_AQUA
  GUAGUAS_SOCCER
}

enum PlanType {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
}

enum PaymentMode {
  TOTAL
  CUOTAS
}

enum ClientStatus {
  ACTIVO
  INACTIVO
  VENCIDO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

enum CampaignStatus {
  BORRADOR
  ENVIANDO
  ENVIADA
  FALLIDA
}

enum ExpenseCategory {
  NOMINA
  ARRIENDO
  SERVICIOS_PUBLICOS
  IMPLEMENTOS
  MARKETING
  MANTENIMIENTO
  ADMINISTRATIVO
  OTROS
}

enum ExpenseMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id           String       @id @default(cuid())
  fullName     String
  birthDate    DateTime
  guardianName String
  phone        String
  email        String?
  program      Program
  planType     PlanType
  paymentMode  PaymentMode  @default(TOTAL)
  installments Int          @default(1)
  paymentDate  DateTime
  dueDate      DateTime
  status       ClientStatus @default(ACTIVO)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  enrollments Enrollment[]
  payments    Payment[]
  attendances Attendance[]
  messages    Message[]
}

model ClassGroup {
  id         String   @id @default(cuid())
  name       String
  program    Program
  dayOfWeek  Int
  startTime  String
  endTime    String
  capacity   Int      @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]
  sessions    ClassSession[]
}

model Enrollment {
  id           String     @id @default(cuid())
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId String
  createdAt    DateTime   @default(now())

  @@unique([clientId, classGroupId])
}

model ClassSession {
  id           String       @id @default(cuid())
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId String
  date         DateTime
  createdAt    DateTime     @default(now())

  attendances  Attendance[]

  @@unique([classGroupId, date])
}

model Attendance {
  id             String            @id @default(cuid())
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  classSession   ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  classSessionId String
  status         AttendanceStatus  @default(PRESENTE)
  createdAt      DateTime          @default(now())

  @@unique([clientId, classSessionId])
}

model Payment {
  id        String        @id @default(cuid())
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  amount    Decimal       @db.Decimal(10, 2)
  concept   String
  status    PaymentStatus @default(PENDIENTE)
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Expense {
  id        String          @id @default(cuid())
  date      DateTime
  category  ExpenseCategory
  concept   String
  provider  String?
  amount    Decimal         @db.Decimal(10, 2)
  method    ExpenseMethod   @default(TRANSFERENCIA)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  templateBody String
  status      CampaignStatus @default(BORRADOR)
  createdAt   DateTime       @default(now())
  sentAt      DateTime?

  messages    Message[]
}

model Message {
  id           String    @id @default(cuid())
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId   String?
  body         String
  waMessageId  String?
  status       String    @default("PENDIENTE")
  createdAt    DateTime  @default(now())
}
