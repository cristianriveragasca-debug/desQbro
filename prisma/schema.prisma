generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum Program {
  DESQBRO_BEBES
  DESQBRO_AQUA
  GUAGUAS_SOCCER
}

enum PlanType {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
}

enum PaymentMode {
  TOTAL
  CUOTAS
}

enum ClientStatus {
  ACTIVO
  INACTIVO
  VENCIDO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

enum CampaignStatus {
  BORRADOR
  ENVIANDO
  ENVIADA
  FALLIDA
}

enum ExpenseCategory {
  NOMINA
  ARRIENDO
  SERVICIOS_PUBLICOS
  IMPLEMENTOS
  MARKETING
  MANTENIMIENTO
  ADMINISTRATIVO
  OTROS
}

enum ExpenseMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  AGENDADO
  DESCARTADO
  CONVERTIDO
}

enum ProgressLevel {
  INICIACION
  BASICO
  INTERMEDIO
  AVANZADO
  EXPERTO
}

enum SwimLevel {
  EXPLORACION
  DESARROLLO
  EXPERTOS
  EGRESADO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ParentAccount {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients Client[]
}

model Client {
  id              String         @id @default(cuid())
  fullName        String
  birthDate       DateTime
  guardianName    String
  phone           String
  email           String?
  notes           String?
  parentAccount   ParentAccount? @relation(fields: [parentAccountId], references: [id], onDelete: SetNull)
  parentAccountId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions ProgramSubscription[]
  enrollments   Enrollment[]
  attendances   Attendance[]
  messages      Message[]
  callUps       EventCallUp[]
}

model ProgramSubscription {
  id            String        @id @default(cuid())
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  program       Program
  planType      PlanType
  paymentMode   PaymentMode   @default(TOTAL)
  installments  Int           @default(1)
  customAmount  Decimal?      @db.Decimal(10, 2)
  paymentDate   DateTime
  dueDate       DateTime
  status        ClientStatus  @default(ACTIVO)
  progressLevel ProgressLevel @default(INICIACION)
  swimLevel     SwimLevel     @default(EXPLORACION)
  swimChecklist Json          @default("{}")
  soccerBadges  Json          @default("[]")
  closingLetter String?
  babySkills    Json          @default("{}")
  babyBadges    Json          @default("[]")
  specialistNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments           Payment[]
  coachNotes         CoachNote[]
  monthlyEvaluations MonthlyEvaluation[]
  portfolioMoments   PortfolioMoment[]

  @@unique([clientId, program])
}

model MonthlyEvaluation {
  id              String              @id @default(cuid())
  subscription    ProgramSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId  String
  month           DateTime
  skills          Json
  sessionsAttended Int
  sessionsTotal    Int
  strength        String
  focusArea       String
  specialNote     String?
  nextGoal        String
  parentPhrase    String
  createdAt       DateTime            @default(now())

  @@unique([subscriptionId, month])
}

model PortfolioMoment {
  id             String              @id @default(cuid())
  subscription   ProgramSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  date           DateTime
  title          String
  description    String?
  createdAt      DateTime            @default(now())
}

model CoachNote {
  id             String              @id @default(cuid())
  subscription   ProgramSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  date           DateTime
  note           String
  createdAt      DateTime            @default(now())
}

model TrialRequest {
  id           String     @id @default(cuid())
  guardianName String
  babyName     String
  birthDate    DateTime
  address      String
  phone        String
  email        String?
  status       LeadStatus @default(NUEVO)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MonthlyIncomeOverride {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  program   Program
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, program])
}

model SpecialEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  program     Program?
  isMatch     Boolean  @default(false)
  date        DateTime
  createdAt   DateTime @default(now())

  callUps EventCallUp[]
}

model EventCallUp {
  id        String       @id @default(cuid())
  event     SpecialEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  createdAt DateTime     @default(now())

  @@unique([eventId, clientId])
}

model ClassGroup {
  id         String   @id @default(cuid())
  name       String
  program    Program
  dayOfWeek  Int
  startTime  String
  endTime    String
  capacity   Int      @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]
  sessions    ClassSession[]
}

model Enrollment {
  id           String     @id @default(cuid())
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId String
  createdAt    DateTime   @default(now())

  @@unique([clientId, classGroupId])
}

model ClassSession {
  id           String       @id @default(cuid())
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId String
  date         DateTime
  createdAt    DateTime     @default(now())

  attendances  Attendance[]

  @@unique([classGroupId, date])
}

model Attendance {
  id             String            @id @default(cuid())
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  classSession   ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  classSessionId String
  status         AttendanceStatus  @default(PRESENTE)
  createdAt      DateTime          @default(now())

  @@unique([clientId, classSessionId])
}

model Payment {
  id             String              @id @default(cuid())
  subscription   ProgramSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  amount         Decimal             @db.Decimal(10, 2)
  concept        String
  status         PaymentStatus       @default(PENDIENTE)
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Expense {
  id        String          @id @default(cuid())
  date      DateTime
  category  ExpenseCategory
  concept   String
  provider  String?
  amount    Decimal         @db.Decimal(10, 2)
  method    ExpenseMethod   @default(TRANSFERENCIA)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  templateBody String
  status      CampaignStatus @default(BORRADOR)
  createdAt   DateTime       @default(now())
  sentAt      DateTime?

  messages    Message[]
}

model Message {
  id           String    @id @default(cuid())
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId   String?
  body         String
  waMessageId  String?
  status       String    @default("PENDIENTE")
  createdAt    DateTime  @default(now())
}
